@page
@model CircusLuna.Pages.CreatePerformanceModel
@{
    ViewData["Title"] = "Create New Performance";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Add New Performance</h3>
                </div>
                <div class="card-body">
                    <form method="post">
                        <!-- Name -->
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">Forestillingens Navn</label>
                            <input asp-for="Name" class="form-control" placeholder="e.g. Moonlight Spectacle" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <!-- Date -->
                        <div class="mb-3">
                            <label asp-for="Date" class="form-label">Dato og tid</label>
                            <input asp-for="Date" class="form-control" type="datetime-local" />
                            <span asp-validation-for="Date" class="text-danger"></span>
                        </div>

                        <!-- City -->
                        <div class="mb-3">
                            <label asp-for="City" class="form-label">By</label>
                            <input asp-for="City" class="form-control" placeholder="e.g. Aarhus" />
                            <span asp-validation-for="City" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="PostalCode" class="form-label">Postnummer</label>
                            <input asp-for="PostalCode" class="form-control" placeholder="e.g. 8000" />
                            <span asp-validation-for="PostalCode" class="text-danger"></span>
                        </div>

                        <!-- Venue Name 
                        <div class="mb-3">
                            <label asp-for="Venue" class="form-label">Venue/Tent Name</label>
                            <input asp-for="Venue" class="form-control" placeholder="e.g. Grand Big Top" />
                            <span asp-validation-for="Venue" class="text-danger"></span>
                        </div>-->

                        <!-- Artists (Comma separated input) -->
                        <div class="mb-3">
                            <label class="form-label d-block">Vælg Artister</label>
                            <div class="card p-3" style="max-height: 200px; overflow-y: auto;">
                                @foreach (var artist in Model.AllArtists)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox"
                                               name="SelectedArtistIds"
                                               value="@artist.ID"
                                               id="artist-@artist.ID">
                                        <label class="form-check-label" for="artist-@artist.ID">
                                            @artist.Name (@artist.Role)
                                        </label>
                                    </div>
                                }
                            </div>
                            <small class="text-muted">Sæt kryds ved alle de artister, der deltager i forestillingen.</small>
                        </div>
                        <div class="d-grid gap-2">
                            <!--  asp-page-handler is only necessary if there are several forms-->
                            <button type="submit" class="btn btn-success">
                                Save Performance
                            </button>
                            <a asp-page="/Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>