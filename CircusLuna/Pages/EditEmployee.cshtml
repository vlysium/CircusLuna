@page
@model CircusLuna.Pages.EditEmployeeModel
@{
}


<div class="container mt-5">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Opdater medarbejder</h3>
        </div>
        <div class="card-body">
            <form method="post">
                <input type="hidden" asp-for="ID" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="PaymentInfo" class="form-label">Kontonummer</label>
                        <input asp-for="PaymentInfo" class="form-control" placeholder="IBAN453456" />
                        <span asp-validation-for="PaymentInfo" class="text-danger"></span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Role" class="form-label">Indtast rolle</label>
                        <input asp-for="Role" class="form-control" placeholder="Clown" />
                        <span asp-validation-for="Role" class="text-danger"></span>
                    </div>
                </div>
              
                <div class="row">
                    <!-- Basic Information -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Name" class="form-label">Navn</label>
                        <input asp-for="Name" class="form-control" placeholder="John Doe" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="john@example.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Number" class="form-label">Telefon</label>
                        <input asp-for="Number" class="form-control" placeholder="+45 12 34 56 78" />
                        <span asp-validation-for="Number" class="text-danger"></span>
                    </div>
                </div>

                <hr />
      
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="form-check form-switch mt-2">
                            <!-- form-switch makes it look like a toggle, remove 'form-switch' for a standard box -->
                            <input asp-for="IsPermanent" class="form-check-input" type="checkbox" id="permanentCheck">
                            <label class="form-check-label" for="permanentCheck">
                                Fastansat (Permanent Artist)
                            </label>
                        </div>
                        <span asp-validation-for="IsPermanent" class="text-danger"></span>
                    </div>
                </div>
                <div class="mt-4">
                    <button type="submit" class="btn btn-success px-4">Gem</button>
                    <a asp-page="/Index" class="btn btn-outline-secondary px-4 ms-2">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>