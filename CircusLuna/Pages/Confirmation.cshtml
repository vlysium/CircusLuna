@page
@model CircusLuna.Pages.ConfirmationModel
@{
}

<p>Debug - Seats Count: @Model.SeatIds?.Count</p>
<p>Debug - Ticket Type: @Model.TicketTypeString</p>

<h3>Gennemse din ordre, @Model.CustName</h3>
<p>Nummer: @Model.CustNumber</p>
<p>Email: @Model.CustEmail</p>
<p>Forestilling: @Model.Performance.Name</p>
<p>Siddepladser: @string.Join(", ", Model.SeatIds)</p>
<p>Samlet pris: @Model.TotalPrice</p>

<form method="post">

    <input type="hidden" asp-for="PerformanceId" />
    <input type="hidden" asp-for="TicketTypeString" />
    @for (int i = 0; i < Model.SeatIds.Count; i++)
    {
        <input type="hidden" asp-for="SeatIds[i]" />
    }
    <button type="submit" class="btn btn-success">Bekræft og betal</button>
    <a asp-page="Index" class="btn btn-outline-secondary px-4 ms-2">Afbryd</a>
</form>
