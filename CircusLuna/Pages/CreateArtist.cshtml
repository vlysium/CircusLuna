@page
@model CircusLuna.Pages.CreateArtistModel
@{
}

<div class="container mt-5">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Tilføj Artist</h3>
        </div>
        <div class="card-body">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Artist.PaymentInfo" class="form-label">Kontonummer</label>
                        <input asp-for="Artist.PaymentInfo" class="form-control" placeholder="IBAN453456" />
                        <span asp-validation-for="Artist.PaymentInfo" class="text-danger"></span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Artist.Role" class="form-label">Indtast rolle</label>
                        <input asp-for="Artist.Role" class="form-control" placeholder="Clown" />
                        <span asp-validation-for="Artist.Role" class="text-danger"></span>
                    </div>
                </div>
              
                <div class="row">
                    <!-- Basic Information -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Artist.Name" class="form-label">Navn</label>
                        <input asp-for="Artist.Name" class="form-control" placeholder="John Doe" />
                        <span asp-validation-for="Artist.Name" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Artist.Email" class="form-label">Email</label>
                        <input asp-for="Artist.Email" type="email" class="form-control" placeholder="john@example.com" />
                        <span asp-validation-for="Artist.Email" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Artist.Number" class="form-label">Telefon</label>
                        <input asp-for="Artist.Number" class="form-control" placeholder="+45 12 34 56 78" />
                        <span asp-validation-for="Artist.Number" class="text-danger"></span>
                    </div>
                </div>

                <hr />
  @*               <h5 class="mb-3 text-secondary">Address Details</h5>

                <div class="mb-3">
                    <label asp-for="Customer.Address.AddressLine1" class="form-label">Address Line 1</label>
                    <input asp-for="Customer.Address.AddressLine1" class="form-control" placeholder="Street name and number" />
                    <span asp-validation-for="Customer.Address.AddressLine1" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Customer.Address.AddressLine2" class="form-label">Address Line 2 (Optional)</label>
                    <input asp-for="Customer.Address.AddressLine2" class="form-control" placeholder="Apartment, suite, etc." />
                </div>

                <div class="row">
                    <div class="col-md-8 mb-3">
                        <label asp-for="Customer.Address.City" class="form-label">City</label>
                        <input asp-for="Customer.Address.City" class="form-control" />
                        <span asp-validation-for="Customer.Address.City" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Customer.Address.PostalCode" class="form-label">Postal Code</label>
                        <input asp-for="Customer.Address.PostalCode" class="form-control" />
                        <span asp-validation-for="Customer.Address.PostalCode" class="text-danger"></span>
                    </div>
                </div> *@
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="form-check form-switch mt-2">
                            <!-- form-switch makes it look like a toggle, remove 'form-switch' for a standard box -->
                            <input asp-for="Artist.IsPermanent" class="form-check-input" type="checkbox" id="permanentCheck">
                            <label class="form-check-label" for="permanentCheck">
                                Fastansat (Permanent Artist)
                            </label>
                        </div>
                        <span asp-validation-for="Artist.IsPermanent" class="text-danger"></span>
                    </div>
                </div>
                <div class="mt-4">
                    <button type="submit" class="btn btn-success px-4">Gem</button>
                    <a asp-page="/Index" class="btn btn-outline-secondary px-4 ms-2">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>