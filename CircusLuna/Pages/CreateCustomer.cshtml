@page
@model CircusLuna.Pages.CreateCustomerModel
@{
}

<div class="blogpost-container">
    <div class="blogpost-textbox">
        
        <!-- Standardized Heading with a subtle bottom margin -->
        <h1 class="mb-7 pb-4" style="white-space: nowrap; font-size: clamp(1.8rem, 5vw, 3rem); text-align: center;"> Kundeinformation</h1>
        
        <!-- Form elements resting directly inside your custom div structure -->
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- CRITICAL: Hidden inputs to keep data alive -->
            <input type="hidden" asp-for="PerformanceId" />
            <input type="hidden" asp-for="TicketType" />
            @foreach (string id in Model.SelectedSeatIds)
            {
                <input type="hidden" name="SelectedSeats" value="@id" />
            }

            <div class="row">
                <!-- Basic Information -->
                <div class="col-md-6 mb-3">
                    <label asp-for="Name" class="form-label font-weight-bold">Navn</label>
                    <input asp-for="Name" class="form-control" placeholder="Jens Pedersen" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Email" class="form-label font-weight-bold">Email</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="jens@example.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Number" class="form-label font-weight-bold">Telefonnummer</label>
                    <input asp-for="Number" class="form-control" placeholder="12 34 56 78" />
                    <span asp-validation-for="Number" class="text-danger"></span>
                </div>
            </div>

            <!-- Action Buttons aligned right below the input block -->
            <div class="mt-4 pt-2">
                <button type="submit" class="btn btn-success px-4">Fortsæt</button>
                <a asp-page="BookSeats"
                   asp-route-performanceId="@Model.PerformanceId"
                   class="btn btn-outline-secondary px-4 ms-2">Tilbage</a>
            </div>
        </form>

    </div>
</div>