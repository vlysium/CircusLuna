@page
@model CircusLuna.Pages.CreateVenueModel
@{
}
@if(TempData["ErrorMessage"]!=null)
{
<div class="alert alert-danger alert-dismissible fade show my-3" role="alert">
    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"];
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
}

<div class="create-customer-container">
    <div class="create-customer-textbox">
        
        <!-- Standardized Heading aligned with the template -->
        <h1 class="mb-7 pb-4" style="font-size: clamp(1.8rem, 5vw, 3rem); text-align: center;">Create Venue</h1>
        
        <form method="post">
          

            <!-- Venue Name -->
            <div class="row">
                <div class="col-md-12 mb-3">
                    <label asp-for="Venue.Name" class="form-label font-weight-bold">Venue Name</label>
                    <input asp-for="Venue.Name" class="form-control" placeholder="Indtast navn på teltet" />
                    
                </div>
            </div>

            <!-- Seats configured in two columns -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Venue.VipSeats" class="form-label font-weight-bold">Antal VIP sæder</label>
                    <input asp-for="Venue.VipSeats" class="form-control" type="number"  />
                 
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Venue.StandardSeats" class="form-label font-weight-bold">Antal standard sæder</label>
                    <input asp-for="Venue.StandardSeats" class="form-control" type="number"  />
               
                </div>
            </div>

            <!-- Action Buttons aligned right below the input block -->
            <div class="mt-4 pt-2">
                <button type="submit" class="btn btn-success px-4">Save Venue</button>
                <a asp-page="/Index" class="btn btn-outline-secondary px-4 ms-2">Tilbage</a>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    @{
        // await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}